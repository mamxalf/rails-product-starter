<% content_for :title, "Notifications" %>

<main class="mx-auto max-w-6xl px-6 py-8">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-zinc-950">Announcements</h1>
      <p class="mt-1 text-sm text-zinc-600">Send in-app notifications to active users.</p>
    </div>
    <% if Current.user.admin? %>
      <%= link_to "New announcement", new_admin_notification_path, class: "rounded-md bg-zinc-950 px-3 py-2 text-sm font-medium text-white" %>
    <% end %>
  </div>

  <section class="mt-6">
    <h2 class="text-sm font-semibold text-zinc-950">Recent announcement audit</h2>
    <% if @audit_events.any? %>
      <div class="mt-3 overflow-hidden rounded-md border border-zinc-200 bg-white">
        <% @audit_events.each do |event| %>
          <div class="border-b border-zinc-100 p-4 last:border-b-0">
            <p class="font-medium text-zinc-950"><%= event.metadata["title"] %></p>
            <p class="mt-1 text-sm text-zinc-600">
              <%= event.metadata["audience"] %> by <%= event.actor&.name || "System" %>
            </p>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= render "shared/empty_state", title: "No announcements yet.", body: "Submitted announcements will appear here." %>
    <% end %>
  </section>
</main>
