<% content_for :title, @user.name %>

<main class="mx-auto max-w-6xl px-6 py-8">
  <%= link_to "Back to users", admin_users_path, class: "text-sm text-zinc-700 underline" %>

  <div class="mt-4 flex flex-wrap items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-zinc-950"><%= @user.name %></h1>
      <p class="mt-1 text-sm text-zinc-600"><%= @user.email_address %></p>
    </div>
    <%= render "badge", label: @user.suspended? ? "Suspended" : "Active" %>
  </div>

  <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-md border border-zinc-200 bg-white p-4">
      <dt class="text-sm text-zinc-600">Role</dt>
      <dd class="mt-2 font-semibold text-zinc-950"><%= @user.role.titleize %></dd>
    </div>
    <div class="rounded-md border border-zinc-200 bg-white p-4">
      <dt class="text-sm text-zinc-600">Verification</dt>
      <dd class="mt-2 font-semibold text-zinc-950"><%= @user.email_verified? ? "Verified" : "Unverified" %></dd>
    </div>
    <div class="rounded-md border border-zinc-200 bg-white p-4">
      <dt class="text-sm text-zinc-600">Active sessions</dt>
      <dd class="mt-2 font-semibold text-zinc-950"><%= @active_sessions_count %></dd>
    </div>
    <div class="rounded-md border border-zinc-200 bg-white p-4">
      <dt class="text-sm text-zinc-600">Created</dt>
      <dd class="mt-2 font-semibold text-zinc-950"><%= l(@user.created_at.to_date, format: :long) %></dd>
    </div>
  </dl>

  <section class="mt-8 grid gap-4 lg:grid-cols-2">
    <div class="rounded-md border border-zinc-200 bg-white p-4">
      <h2 class="text-base font-semibold text-zinc-950">Actions</h2>

      <% if Current.user.admin? %>
        <%= form_with url: role_admin_user_path(@user), method: :patch, class: "mt-4 flex flex-wrap gap-2" do |form| %>
          <%= form.select :role, options_for_select(User.roles.keys.map { |role| [role.titleize, role] }, @user.role), {}, name: "user[role]", class: "rounded-md border border-zinc-300 px-3 py-2 text-sm" %>
          <%= form.submit "Update role", class: "rounded-md bg-zinc-950 px-3 py-2 text-sm font-medium text-white" %>
        <% end %>
      <% end %>

      <div class="mt-4 flex flex-wrap gap-2">
        <% if @user.suspended? %>
          <%= button_to "Unsuspend", unsuspend_admin_user_path(@user), method: :patch, form: { data: { turbo_confirm: "Unsuspend this user?" } }, class: "rounded-md border border-zinc-300 px-3 py-2 text-sm text-zinc-700" %>
        <% else %>
          <%= button_to "Suspend", suspend_admin_user_path(@user), method: :patch, form: { data: { turbo_confirm: "Suspend this user and revoke all sessions?" } }, class: "rounded-md border border-zinc-300 px-3 py-2 text-sm text-zinc-700" %>
        <% end %>
        <%= button_to "Revoke sessions", revoke_sessions_admin_user_path(@user), method: :patch, form: { data: { turbo_confirm: "Revoke all sessions for this user?" } }, class: "rounded-md border border-zinc-300 px-3 py-2 text-sm text-zinc-700" %>
      </div>
    </div>

    <div class="rounded-md border border-zinc-200 bg-white p-4">
      <h2 class="text-base font-semibold text-zinc-950">Recent audit events</h2>
      <div class="mt-4 divide-y divide-zinc-200">
        <% @audit_events.each do |event| %>
          <div class="py-3 text-sm">
            <div class="font-medium text-zinc-950"><%= event.action %></div>
            <div class="text-zinc-600">
              <%= event.actor&.email_address || "System" %> · <%= l(event.created_at, format: :short) %>
            </div>
          </div>
        <% end %>
        <% if @audit_events.empty? %>
          <p class="text-sm text-zinc-600">No audit events yet.</p>
        <% end %>
      </div>
    </div>
  </section>
</main>
