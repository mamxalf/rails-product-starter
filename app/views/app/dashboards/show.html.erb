<% content_for :title, "Dashboard" %>

<main class="mx-auto max-w-6xl px-6 py-8">
  <div>
    <h1 class="text-2xl font-semibold text-zinc-950">Dashboard</h1>
    <p class="mt-1 text-sm text-zinc-600">Welcome, <%= Current.user.name %>.</p>
  </div>

  <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    <div class="rounded-md border border-zinc-200 bg-white p-4">
      <dt class="text-sm text-zinc-600">Account</dt>
      <dd class="mt-2 text-base font-semibold text-zinc-950">Verified</dd>
    </div>
    <div class="rounded-md border border-zinc-200 bg-white p-4">
      <dt class="text-sm text-zinc-600">Unread notifications</dt>
      <dd class="mt-2 text-3xl font-semibold text-zinc-950"><%= Current.user.notifications.unread.count %></dd>
    </div>
    <div class="rounded-md border border-zinc-200 bg-white p-4">
      <dt class="text-sm text-zinc-600">Role</dt>
      <dd class="mt-2 text-base font-semibold text-zinc-950"><%= Current.user.role.titleize %></dd>
    </div>
  </dl>

  <section class="mt-8">
    <h2 class="text-sm font-semibold text-zinc-950">Recent notifications</h2>
    <% notifications = Current.user.notifications.recent_first.limit(5) %>
    <% if notifications.any? %>
      <div class="mt-3 overflow-hidden rounded-md border border-zinc-200 bg-white">
        <% notifications.each do |notification| %>
          <div class="border-b border-zinc-100 p-4 last:border-b-0">
            <p class="font-medium text-zinc-950"><%= notification.title %></p>
            <p class="mt-1 text-sm text-zinc-600"><%= notification.body %></p>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= render "shared/empty_state", title: "No notifications yet.", body: "New account activity will appear here." %>
    <% end %>
  </section>
</main>
