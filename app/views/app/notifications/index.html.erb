<% content_for :title, "Notifications" %>

<main class="mx-auto max-w-6xl px-6 py-8">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold text-zinc-950">Notifications</h1>
      <p class="mt-1 text-sm text-zinc-600"><%= pluralize(@unread_count, "unread") %></p>
    </div>
    <% if @unread_count.positive? %>
      <%= button_to "Mark all read", read_all_app_notifications_path, method: :patch, class: "rounded-md bg-zinc-950 px-3 py-2 text-sm font-medium text-white" %>
    <% end %>
  </div>

  <section class="mt-6">
    <% if @notifications.any? %>
      <div class="overflow-hidden rounded-md border border-zinc-200 bg-white">
        <% @notifications.each do |notification| %>
          <div class="border-b border-zinc-100 p-4 last:border-b-0">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="font-medium text-zinc-950"><%= notification.title %></p>
                <p class="mt-1 text-sm text-zinc-600"><%= notification.body %></p>
                <% if notification.action_url.present? %>
                  <%= link_to "Open", notification.action_url, class: "mt-3 inline-block text-sm font-medium text-zinc-950 underline" %>
                <% end %>
              </div>
              <% if notification.read_at? %>
                <span class="rounded-md border border-zinc-200 px-2 py-1 text-xs font-medium text-zinc-600">Read</span>
              <% else %>
                <%= button_to "Mark read", app_notification_path(notification), method: :patch, class: "rounded-md border border-zinc-300 px-3 py-2 text-sm font-medium text-zinc-700 hover:bg-zinc-50" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <%= render "shared/empty_state", title: "No notifications yet.", body: "New account activity will appear here." %>
    <% end %>
  </section>
</main>
