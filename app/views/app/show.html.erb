<% content_for :title, "App" %>

<main class="mx-auto max-w-3xl px-6 py-10">
  <div class="flex items-center justify-between border-b border-zinc-200 pb-4">
    <div>
      <h1 class="text-2xl font-semibold text-zinc-950">App</h1>
      <p class="mt-1 text-sm text-zinc-600">Signed in as <%= Current.user.email_address %></p>
    </div>

    <%= button_to t("navigation.sign_out"), session_path, method: :delete, class: "rounded-md bg-zinc-950 px-3 py-2 text-sm font-medium text-white hover:bg-zinc-800" %>
  </div>
</main>
