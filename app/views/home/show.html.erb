<% content_for :title, ENV.fetch("APP_NAME", "Starter App") %>

<%= render "shared/public_nav" %>
<main class="mx-auto max-w-5xl px-6 py-16">
  <p class="text-sm font-medium text-zinc-600"><%= t("public.home.eyebrow") %></p>
  <h1 class="mt-3 max-w-2xl text-4xl font-semibold text-zinc-950"><%= t("public.home.title") %></h1>
  <p class="mt-4 max-w-2xl text-zinc-600"><%= t("public.home.body") %></p>
  <div class="mt-8 flex gap-3">
    <%= link_to t("sessions.new.title"), new_session_path, class: "rounded-md bg-zinc-950 px-4 py-2 text-sm font-medium text-white hover:bg-zinc-800" %>
    <%= link_to t("public.nav.about"), about_path, class: "rounded-md border border-zinc-300 px-4 py-2 text-sm font-medium text-zinc-950 hover:bg-zinc-50" %>
  </div>
</main>
<%= render "shared/footer" %>
