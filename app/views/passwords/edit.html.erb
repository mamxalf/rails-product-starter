<% content_for :title, t("passwords.edit.title") %>

<%= render "shared/auth_card", title: t("passwords.edit.title") do %>
  <%= form_with url: password_path(params[:token]), method: :put, class: "space-y-6" do |form| %>
    <div>
      <%= form.label :password, t("passwords.edit.password"), class: "block text-sm/6 font-medium text-gray-900" %>
      <div class="mt-2">
        <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
      </div>
    </div>

    <div>
      <%= form.label :password_confirmation, t("forms.password_confirmation"), class: "block text-sm/6 font-medium text-gray-900" %>
      <div class="mt-2">
        <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "block w-full rounded-md bg-white px-3 py-1.5 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6" %>
      </div>
    </div>

    <%= form.submit t("passwords.edit.submit"), class: "flex w-full justify-center rounded-md bg-indigo-600 px-3 py-1.5 text-sm/6 font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600" %>
  <% end %>
<% end %>
