<% content_for :title, t("passwords.new.title") %>

<%= render "shared/auth_card", title: t("passwords.new.title"), body: t("passwords.new.body") do %>
  <%= form_with url: passwords_path, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :email_address, t("forms.email_address"), class: "block text-sm font-medium text-zinc-800" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "mt-2 block w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-zinc-950 shadow-sm focus:border-zinc-950 focus:outline-none" %>
    </div>

    <%= form.submit t("passwords.new.submit"), class: "w-full rounded-md bg-zinc-950 px-3 py-2 text-sm font-medium text-white hover:bg-zinc-800" %>
  <% end %>

  <p class="mt-4 text-sm"><%= link_to t("passwords.new.back"), new_session_path, class: "font-medium text-zinc-950 underline" %></p>
<% end %>
