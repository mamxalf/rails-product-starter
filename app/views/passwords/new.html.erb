<% content_for :title, "Reset password" %>

<main class="flex min-h-screen items-center justify-center bg-zinc-50 px-6 py-12">
  <div class="w-full max-w-sm">
    <h1 class="text-2xl font-semibold text-zinc-950">Reset password</h1>
    <p class="mt-2 text-sm text-zinc-600">Enter your email address and we will send reset instructions.</p>

    <%= form_with url: passwords_path, class: "mt-6 space-y-4" do |form| %>
      <div>
        <%= form.label :email_address, "Email address", class: "block text-sm font-medium text-zinc-800" %>
        <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "mt-2 block w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-zinc-950 shadow-sm focus:border-zinc-950 focus:outline-none" %>
      </div>

      <%= form.submit "Email reset instructions", class: "w-full rounded-md bg-zinc-950 px-3 py-2 text-sm font-medium text-white hover:bg-zinc-800" %>
    <% end %>

    <p class="mt-4 text-sm"><%= link_to "Back to sign in", new_session_path, class: "font-medium text-zinc-950 underline" %></p>
  </div>
</main>
