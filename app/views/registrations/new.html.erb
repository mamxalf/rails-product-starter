<% content_for :title, t("registrations.new.title") %>

<%= render "shared/auth_card", title: t("registrations.new.title") do %>
  <p class="mt-2 text-sm text-zinc-600"><%= t("registrations.new.have_account") %> <%= link_to t("sessions.new.title"), new_session_path, class: "font-medium text-zinc-950 underline" %></p>

  <div class="mt-6">
    <%= render "shared/form_errors", record: @user %>
  </div>

  <%= form_with model: @user, url: registration_path, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-zinc-800" %>
      <%= form.text_field :name, required: true, autocomplete: "name", class: "mt-2 block w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-zinc-950 shadow-sm focus:border-zinc-950 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :email_address, t("forms.email_address"), class: "block text-sm font-medium text-zinc-800" %>
      <%= form.email_field :email_address, required: true, autocomplete: "username", class: "mt-2 block w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-zinc-950 shadow-sm focus:border-zinc-950 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :password, class: "block text-sm font-medium text-zinc-800" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, class: "mt-2 block w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-zinc-950 shadow-sm focus:border-zinc-950 focus:outline-none" %>
    </div>

    <div>
      <%= form.label :password_confirmation, t("forms.password_confirmation"), class: "block text-sm font-medium text-zinc-800" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "mt-2 block w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-zinc-950 shadow-sm focus:border-zinc-950 focus:outline-none" %>
    </div>

    <%= form.submit t("registrations.new.title"), class: "w-full rounded-md bg-zinc-950 px-3 py-2 text-sm font-medium text-white hover:bg-zinc-800" %>
  <% end %>
<% end %>
