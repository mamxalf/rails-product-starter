<% content_for :title, "Account settings" %>

<main class="mx-auto max-w-3xl px-6 py-10">
  <%= render "settings/nav" %>

  <h1 class="text-2xl font-semibold text-zinc-950">Account</h1>
  <%= render "settings/errors", user: @user %>

  <section class="mt-6 border-b border-zinc-200 pb-8">
    <h2 class="text-lg font-semibold text-zinc-950">Email</h2>

    <%= form_with model: @user, url: settings_account_path, method: :patch, class: "mt-4 space-y-4" do |form| %>
      <div>
        <%= form.label :email_address, class: "block text-sm font-medium text-zinc-800" %>
        <%= form.email_field :email_address, class: "mt-1 w-full rounded-md border border-zinc-300 px-3 py-2" %>
      </div>

      <div>
        <%= form.label :current_password, class: "block text-sm font-medium text-zinc-800" %>
        <%= form.password_field :current_password, class: "mt-1 w-full rounded-md border border-zinc-300 px-3 py-2" %>
      </div>

      <%= form.submit "Change email", class: "rounded-md bg-zinc-950 px-3 py-2 text-sm font-medium text-white hover:bg-zinc-800" %>
    <% end %>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-semibold text-zinc-950">Deactivate account</h2>

    <%= form_with scope: :user, url: settings_account_path, method: :delete, class: "mt-4 space-y-4" do |form| %>
      <div>
        <%= form.label :email_confirmation, "Type your email address", class: "block text-sm font-medium text-zinc-800" %>
        <%= form.text_field :email_confirmation, class: "mt-1 w-full rounded-md border border-zinc-300 px-3 py-2" %>
      </div>

      <div>
        <%= form.label :current_password, class: "block text-sm font-medium text-zinc-800" %>
        <%= form.password_field :current_password, class: "mt-1 w-full rounded-md border border-zinc-300 px-3 py-2" %>
      </div>

      <%= form.submit "Deactivate account", class: "rounded-md bg-red-700 px-3 py-2 text-sm font-medium text-white hover:bg-red-600" %>
    <% end %>
  </section>
</main>
