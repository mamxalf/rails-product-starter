<% content_for :title, "Profile settings" %>

<main class="mx-auto max-w-3xl px-6 py-10">
  <%= render "settings/nav" %>

  <h1 class="text-2xl font-semibold text-zinc-950">Profile</h1>
  <%= render "settings/errors", user: @user %>

  <%= form_with model: @user, url: settings_profile_path, method: :patch, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :name, class: "block text-sm font-medium text-zinc-800" %>
      <%= form.text_field :name, class: "mt-1 w-full rounded-md border border-zinc-300 px-3 py-2" %>
    </div>

    <div>
      <%= form.label :avatar, class: "block text-sm font-medium text-zinc-800" %>
      <%= form.file_field :avatar, class: "mt-1 block w-full text-sm text-zinc-700" %>
    </div>

    <%= form.submit "Save profile", class: "rounded-md bg-zinc-950 px-3 py-2 text-sm font-medium text-white hover:bg-zinc-800" %>
  <% end %>
</main>
