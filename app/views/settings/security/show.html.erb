<% content_for :title, "Security settings" %>

<main class="mx-auto max-w-3xl px-6 py-10">
  <%= render "settings/nav" %>

  <h1 class="text-2xl font-semibold text-zinc-950">Security</h1>
  <%= render "settings/errors", user: @user %>

  <%= form_with scope: :user, url: settings_security_path, method: :patch, class: "mt-6 space-y-4" do |form| %>
    <div>
      <%= form.label :current_password, class: "block text-sm font-medium text-zinc-800" %>
      <%= form.password_field :current_password, class: "mt-1 w-full rounded-md border border-zinc-300 px-3 py-2" %>
    </div>

    <div>
      <%= form.label :password, "New password", class: "block text-sm font-medium text-zinc-800" %>
      <%= form.password_field :password, class: "mt-1 w-full rounded-md border border-zinc-300 px-3 py-2" %>
    </div>

    <div>
      <%= form.label :password_confirmation, class: "block text-sm font-medium text-zinc-800" %>
      <%= form.password_field :password_confirmation, class: "mt-1 w-full rounded-md border border-zinc-300 px-3 py-2" %>
    </div>

    <%= form.submit "Change password", class: "rounded-md bg-zinc-950 px-3 py-2 text-sm font-medium text-white hover:bg-zinc-800" %>
  <% end %>
</main>
