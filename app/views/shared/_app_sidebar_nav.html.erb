<% user = Current.user %>
<% nav_item = ->(label, path, active_on: nil) do %>
  <% active = current_page?(path) || (active_on && request.path.start_with?(active_on)) %>
  <li>
    <%= link_to path, class: [
      "group flex gap-x-3 rounded-md p-2 text-sm/6 font-semibold",
      active ? "bg-zinc-50 text-zinc-950" : "text-zinc-700 hover:bg-zinc-50 hover:text-zinc-950"
    ] do %>
      <span class="flex size-6 shrink-0 items-center justify-center rounded-md border border-zinc-200 bg-white text-[0.625rem] font-semibold text-zinc-500"><%= label.first %></span>
      <span><%= label %></span>
    <% end %>
  </li>
<% end %>

<div class="flex h-16 shrink-0 items-center">
  <%= link_to ENV.fetch("APP_NAME", "Starter App"), app_dashboard_path, class: "text-sm font-semibold text-zinc-950" %>
</div>

<nav aria-label="App" class="flex flex-1 flex-col">
  <ul role="list" class="flex flex-1 flex-col gap-y-7">
    <li>
      <ul role="list" class="-mx-2 space-y-1">
        <% nav_item.call("Dashboard", app_dashboard_path) %>
        <% nav_item.call("Notifications", app_notifications_path) %>
        <% nav_item.call("Settings", settings_profile_path, active_on: "/settings") %>
        <% if user&.staff? || user&.admin? %>
          <% nav_item.call("Admin", admin_path, active_on: "/admin") %>
        <% end %>
      </ul>
    </li>
    <li class="-mx-2 mt-auto space-y-1">
      <div class="flex gap-2 px-2">
        <% I18n.available_locales.each do |locale| %>
          <%= button_to locale.to_s.upcase, locale_path, method: :patch, params: { locale: locale }, class: "rounded-md border border-zinc-300 px-2 py-1 text-xs font-medium text-zinc-700 hover:bg-zinc-50" %>
        <% end %>
      </div>
      <div class="px-2 py-3 text-sm">
        <p class="font-medium text-zinc-950"><%= user&.name %></p>
        <p class="truncate text-zinc-500"><%= user&.email_address %></p>
      </div>
      <%= button_to "Sign out", session_path, method: :delete, class: "w-full rounded-md bg-zinc-950 px-3 py-2 text-sm font-medium text-white hover:bg-zinc-800" %>
    </li>
  </ul>
</nav>
