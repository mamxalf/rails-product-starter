#!/usr/bin/env bash
set -euo pipefail

step() {
  local name="$1"
  shift
  local start=$SECONDS

  printf '\n==> %s\n' "$name"
  "$@"
  printf '==> %s done (%ss)\n' "$name" "$((SECONDS - start))"
}

step "RuboCop" bundle exec rubocop
step "Brakeman" bundle exec brakeman -q --no-pager
step "Bundler audit" bundle exec bundler-audit check --update
step "RSpec" bundle exec rspec
step "Svelte check" pnpm run check
step "ESLint" pnpm run lint
step "Prettier check" pnpm run format:check
step "Vitest" pnpm run test
step "Assets precompile" env RAILS_ENV=production SECRET_KEY_BASE_DUMMY=1 bin/rails assets:precompile
